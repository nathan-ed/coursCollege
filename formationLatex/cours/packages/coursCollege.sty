\fancyhead[LO,RE]{  \ifnum\value{page}=1
    \slshape \Chapitre
  \else
    \slshape \Chapitre~-- Partie~\thesection,~\currentname
  \fi
}
\fancyfoot[C]{\thepage/\pageref{LastPage}}
\fancyfoot[LE,RO]{\slshape ns}
