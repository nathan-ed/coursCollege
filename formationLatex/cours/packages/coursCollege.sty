% Global tcolorbox settings
\tcbset{
    boxrule=0pt,    
    left=0pt, right=0pt,
    sharp corners,
    width=\linewidth,
    before skip=0pt, after skip=0pt,
    sidebyside, sidebyside gap=5mm,
    sidebyside align=top,
    righthand width=0.75\linewidth,
    lefthand width=0.25\linewidth,
    colback=white,
    fontupper=\raggedleft,  
    fontlower=\justifying,  
    colframe=white % No border
}

\newtcolorbox[auto counter, number within=section]{exemple}[1][]{
    before upper={\raggedleft\textbf{\stepcounter{exemple}Exemple~\thesection.\theexemple}\\\vspace{0.5em}},
    before lower={\noindent},
    #1
}


\newtcolorbox[auto counter, number within=section]{formule}[1][]{
    before upper={\raggedleft\textbf{\stepcounter{formule}Formule~\theformule}\\\vspace{0.5em}},
    before lower={\noindent},
    #1
}

\newtcolorbox[auto counter, number within=section]{definition}[1][]{
    before upper={\raggedleft\textbf{\stepcounter{definition}Définition~\thesection.\thedefinition}\\\vspace{0.5em}},
    before lower={\noindent},
    #1
}

\newtcolorbox[auto counter, number within=section]{remarque}[1][]{
    before upper={\raggedleft\textbf{\stepcounter{remarque}Remarque}\\\vspace{0.5em}},
    before lower={\noindent},
    #1
}


\newtcolorbox[]{activite}[1][]{
	breakable,
    before upper={\raggedright\textbf{\stepcounter{activite}Activité~\theactivite}\\},
    before lower={\noindent},
    #1
}

\newtcolorbox[]{thm}[1][]{
    before upper={\raggedleft\textbf{Théorème}\\},
    before lower={\noindent},
    #1
}

% Define the exercice environment
\newtcolorbox{exercice}[1][]{ % #1 = difficulty (default 0), #2 = extra options
    before upper={
        \stepcounter{exercice}%
        \fbox{\raggedleft\textbf{Exercice~\thesection.\theexercice}}%
        \\
        \ifnum#1>0
            \foreach \i in {1,...,#1}{%
                {\small \faPepperHot}%
            }%
        \fi
        \\ \vspace{0.5em}
    },
    before lower={\vspace{0.3em}\noindent}
}
\DeclareEmphSequence{\bfseries\itshape}
\makeatletter
\def\myrulefill{\leavevmode\leaders\hrule height .7ex width 1ex depth -0.6ex\hfill\kern\z@}
\makeatother

\newcommand{\textLigne}[1]{\myrulefill {{\footnotesize ~#1}} \myrulefill\par}


